package org.mst.sarl.agents

import io.sarl.api.core.DefaultContextInteractions
import io.sarl.api.core.Initialize
import io.sarl.api.core.Lifecycle
import io.sarl.api.core.Logging
import org.mst.sarl.core.MSTService

/**
 * Acts on behalf of one stakeholder role (OCCUPANT, FACILITY_MANAGER or SECURITY).
 * For each MSTRequest it calls the Exact MST service on its role-specific pool and
 * emits the selection as an MSTResponse.
 */
agent RoleAgent {

	uses Logging, DefaultContextInteractions, Lifecycle

	var role : String

	on Initialize {
		this.role = occurrence.parameters.get(0) as String
		loggingName = "RoleAgent-" + this.role
		emit(new RoleReady(this.role))
	}

	on MSTRequest {
		// Exact MST selection for this role, scenario and threshold.
		val result = MSTService.evaluate(this.role, occurrence.scenario, occurrence.tau)
		emit(new MSTResponse(
			this.role,
			occurrence.scenario,
			occurrence.tau,
			result.getStatus(),
			result.getSelectedItems(),
			result.getUtility(),
			result.getPrivacyExposure(),
			result.getInterpretationCost(),
			result.getObjective(),
			result.isSufficient(),
			result.isPrivacyAdmissible(),
			result.isMinimal()))
	}

	on StopRoles {
		killMe
	}
}
